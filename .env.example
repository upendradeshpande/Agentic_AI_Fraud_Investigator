# ---- LLM (pick one provider; leave all keys empty for deterministic mode) ----
# LLM_PROVIDER is auto-detected from whichever key is set. Set it explicitly to force one.
# You can also connect a model at runtime in the app: header -> "Model connection".
# LLM_PROVIDER=gemini            # gemini | anthropic | openai | openai_compatible | none
# LLM_MODEL=                     # optional override for any provider
# LLM_API_KEY=                   # generic key, used if the provider-specific key below is empty

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local or self-hosted model with an OpenAI-compatible API (Ollama, vLLM, LM Studio, LiteLLM gateway):
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# ---- Agent runtime ----
AGENT_RUNTIME=native             # native (default, any provider) | adk (Google ADK, pip install -r requirements-optional.txt)
AGENT_MAX_TOOL_CALLS=6
LLM_TIMEOUT_S=45

# ---- Features ----
ENABLE_LLM=true
ENABLE_RAG=false

# ---- Hosting a public demo (all optional) ----
# APP_PASSWORD=choose-a-demo-password          # asks visitors for this password once per session
# SESSION_QUESTION_LIMIT=20                    # max copilot questions per visitor (0 = unlimited)
# DEMO_NOTICE=Demo: changes reset when the app restarts.

# ---- Import limits ----
MAX_IMPORT_ROWS=2000000
MAX_UPLOAD_MB=200

# ---- Storage ----
DATABASE_URL=sqlite:///data/cockpit.db

# ---- Cost estimate shown in the Evaluation tab (USD per million tokens; check your provider's pricing) ----
LLM_PRICE_INPUT_PER_MTOK=0.30
LLM_PRICE_OUTPUT_PER_MTOK=2.50
